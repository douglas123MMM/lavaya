{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@lavaya/types": ["../../packages/types"],
      "@lavaya/config": ["../../packages/config"],
      "@lavaya/shared": ["../../packages/shared"]
    }
